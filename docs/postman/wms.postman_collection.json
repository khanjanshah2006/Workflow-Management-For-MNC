              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.mfa_required) {",
                  "        pm.environment.set(\"mfa_token\", jsonData.mfa_token);",
                  "        console.log(\"MFA challenge required. Ephemeral mfa_token set:\", jsonData.mfa_token);",
                  "    } else {",
                  "        pm.environment.set(\"access_token\", jsonData.access_token);",
                  "        console.log(\"Admin access token set:\", jsonData.access_token);",
                  "    }",
