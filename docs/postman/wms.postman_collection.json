              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "teams",
                "{{team_id}}",
                "members"
              ]
            },
            "description": "US-37: Returns all ACTIVE employees assigned to the specified team.\n\nAccess rules (enforced server-side):\n- HR Manager and SysAdmin can query any team's roster.\n- PM can query any team roster.\n- Team Lead can query their own assigned team.\n- 403 Forbidden if querying other teams or if non-lead employee / client.\n- 404 Not Found if team does not exist.\n- Returns empty array [] cleanly if team has no assigned members."
          },
          "response": [
            {
              "name": "200 OK \u2013 Active Team Members",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[\n  {\n    \"employee_id\": 2,\n    \"emp_code\": \"EMP-DEV-02\",\n    \"full_name\": \"John Reese\",\n    \"email\": \"member@company.com\",\n    \"designation\": \"Senior Backend Engineer\"\n  }\n]",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "200 OK \u2013 Empty Team",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "[]",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "403 Forbidden \u2013 Other Team / Non-Lead",
              "status": "Forbidden",
              "code": 403,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"detail\": \"Access forbidden: you are not authorized to view team 2\"\n}",
              "_postman_previewlanguage": "json"
            },
            {
              "name": "404 Not Found \u2013 Team Non-existent",
              "status": "Not Found",
              "code": 404,
              "header": [
