# Copy to backend/.env and fill in. Real environment variables override this file.

# development | production. In production the app refuses to start unless
# JWT_SECRET_KEY, DATABASE_URL and CORS_ORIGINS are set and the JWT secret is
# not the default and is at least 32 characters long.
ENV=development

# Database (Supabase PostgreSQL or local SQLite, e.g. sqlite:///wms_dev.db)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=10

# JWT. Generate a production secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origins allowed by CORS (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Refresh token cookie. Use COOKIE_SECURE=true behind HTTPS.
# COOKIE_SAMESITE is lax | strict | none (none requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Feature toggles
ENABLE_DOCS=true
ENFORCE_ADMIN_MFA=false
MAX_UPLOAD_MB=5
LOG_LEVEL=INFO

# Shared token for scheduled job endpoints
JOB_TOKEN=

# Database backups (US-34)
BACKUP_DIR=./backups
PG_DUMP_PATH=
BACKUP_TIMEOUT_SECONDS=300

# Anomaly detection thresholds (US-35)
FAILED_LOGIN_THRESHOLD=5
FAILED_LOGIN_WINDOW_MINUTES=15

# Executive report storage (defaults to <repo>/uploads/reports)
REPORTS_DIR=
